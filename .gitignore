# ============================================
# UNITY - .gitignore
# ============================================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Builds
[Bb]uild/
[Bb]uilds/

# ============================================
# IDE / EDITOR
# ============================================

# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.DotSettings.user

# VS Code
.vscode/

# ============================================
# OPERATING SYSTEM
# ============================================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~

# ============================================
# UNITY GENERATED FILES
# ============================================

sysinfo.txt
mono_crash.*

*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity temporary files
.utmp/

# ============================================
# BUILDS / PACKAGES
# ============================================

*.apk
*.aab
*.app

# Unity packages exported manually
*.unitypackage

# ============================================
# GRADLE
# ============================================

.gradle/

# ============================================
# BLENDER
# ============================================

# Blender backup files only.
# IMPORTANT: .blend files themselves ARE uploaded.
*.blend1
*.blend1.meta

# ============================================
# CRASHLYTICS
# ============================================

crashlytics-build.properties

# ============================================
# TEST GENERATED FILES
# ============================================

InitTestScene*.unity*

# ============================================
# IMPORTANTE
# ============================================
#
# NO IGNORAR:
#
# Assets/
# Packages/
# ProjectSettings/
#
# Tampoco ignorar:
#
# *.unity
# *.prefab
# *.mat
# *.meta
# *.cs
# *.fbx
# *.obj
# *.blend
# *.png
# *.jpg
# *.wav
# *.mp3
#
# Los archivos .meta son ESENCIALES para que
# Unity conserve referencias entre escenas,
# prefabs, materiales, scripts, modelos, etc.
#
# ============================================